# Local demo settings. NO SECRETS in this file: it is committed on purpose.
# start-demo copies it to .env.local when that file doesn't exist yet.
# Supabase is not needed for the demo; the .invalid URL keeps email sign-in hidden.
NEXT_PUBLIC_SUPABASE_URL=https://demo.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=demo-placeholder-not-a-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_ORIGIN=http://127.0.0.1:8000
GOOGLE_AUTH_ENABLED=false
DEMO_MODE=true
# Optional: paste a free key from console.groq.com into .env.local (NOT this file) so the
# chat can answer any question. Without it, open questions get a polite local fallback.
GROQ_API_KEY=
