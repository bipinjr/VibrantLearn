# Copy to apps/web/.env.local and apps/api/.env. Values below are FAKE.
# Local values come from `npx supabase status` after `npx supabase start`.

# ---- apps/web (browser may only see these three NEXT_PUBLIC_ vars) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fake
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# server-only: where /api/v1/* is rewritten to
API_ORIGIN=http://127.0.0.1:8000
# server-only: show "Continue with Google" once OAuth is configured in Supabase
GOOGLE_AUTH_ENABLED=false

# ---- apps/api (server only, never in the browser) ----
ENV=development
# Supavisor pooled connection (transaction mode) in prod; local direct DB below
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_fake
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
IP_HASH_SALT=change-me-long-random-string
# true only behind Vercel (or another proxy you control); never true when the API is reachable directly
TRUSTED_PROXY=false
GROQ_API_KEY=
MAX_UPLOAD_MB=50
# server-only: enables the "Try the demo" sign-in with sample data. Never true in production.
DEMO_MODE=false

# Local demo only: verify new teachers immediately (never in production)
TEACHER_AUTO_VERIFY=false
# Local demo only: lower the class rules (production: 10 and 30)
CLASS_MIN_STUDENTS=10
CLASS_MIN_LEAD_MIN=30
